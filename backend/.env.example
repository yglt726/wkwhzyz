# 本地演练数据库（SQLite，Prisma 直接建库）
# 生产切换 PostgreSQL 时改为：
# DATABASE_URL="postgresql://lab:lab123@localhost:5432/lab_selection?schema=public"
# 并把 prisma/schema.prisma 的 provider 改为 "postgresql"
DATABASE_URL="file:./dev.db"

JWT_SECRET="lab-selection-dev-secret-please-change"
PORT=3000

# 可选：不配置则使用进程内串行锁（单实例兜底）
# REDIS_URL="redis://127.0.0.1:6379"
